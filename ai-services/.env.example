# Vector Database Configuration (Qdrant Cloud vs Local Docker)
# For Existing Qdrant Cloud Cluster (e.g. shared with SiteMind):
# QDRANT_URL=https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_placeholder
# CRITICAL: Dedicated collection name separates PrepAI data from SiteMind data on the same cluster
QDRANT_COLLECTION=prepai_knowledge
# Vector dimension matching gemini-embedding-2 native output (default: 3072)
QDRANT_VECTOR_SIZE=3072
# Request timeout in seconds (default: 10.0)
QDRANT_TIMEOUT=10.0
# For Local Docker Development (uncomment to override):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

GEMINI_API_KEY=your_gemini_api_key_placeholder
# Gemini Multi-Project Quota Failover (Optional)
# CRITICAL: GEMINI_FALLBACK_API_KEY must belong to a SEPARATE eligible Google Cloud Project.
# Keys from the same GCP project share quota and do NOT provide project-level quota failover.
GEMINI_FALLBACK_API_KEY=your_gemini_fallback_api_key_from_separate_project_placeholder
# Enable automatic failover when primary project daily quota is confirmed exhausted (default: false)
GEMINI_FAILOVER_ENABLED=false

# LangSmith AI Observability (Python FastAPI & LangGraph)
# Set LANGSMITH_TRACING=true to enable metadata-only Gemini & LangGraph observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_placeholder
LANGSMITH_PROJECT=prepai-ai-services
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Service-to-Service Internal Authentication & Concurrency Protection
# MANDATORY: Generate a high-entropy secret (e.g. openssl rand -hex 32). Must match server exactly.
AI_SERVICE_SECRET=your_internal_service_secret_placeholder
MAX_CONCURRENT_AI_REQUESTS=5
MAX_REQUEST_BODY_BYTES=10485760
GEMINI_MAX_RETRIES=2

# Command for running the ai service
# .\.venv\Scripts\Activate.ps1
# uvicorn app.main:app --host 127.0.0.1 --port 9000 --reload