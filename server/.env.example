# PrepAI Server Environment Configuration Template
PORT=5000
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname
JWT_SECRET=your_jwt_secret_here_min_32_chars
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder
# Gemini Multi-Project Quota Failover (Optional)
# CRITICAL: GEMINI_FALLBACK_API_KEY must belong to a SEPARATE eligible Google Cloud Project.
# Keys from the same GCP project share quota and do NOT provide project-level quota failover.
GEMINI_FALLBACK_API_KEY=your_gemini_fallback_api_key_from_separate_project_placeholder
# Enable automatic failover when primary project daily quota is confirmed exhausted (default: false)
GEMINI_FAILOVER_ENABLED=false
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_placeholder
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io

# Python AI Service URL (FastAPI/LangGraph)
# NOTE: Vector storage (Qdrant Cloud/Local) is managed exclusively by the Python AI service.
# The Node.js Express server proxies resume indexing and retrieval requests through this endpoint.
# Local hybrid setup (Express & FastAPI on host): http://localhost:9000
# Dockerized Express connecting to host FastAPI: http://host.docker.internal:9000
AI_SERVICE_URL=http://localhost:9000
# AI Service request timeout in milliseconds (default: 120000 / 2 minutes)
AI_SERVICE_TIMEOUT_MS=120000

# Dedicated AES-256 key for authenticated encryption of hidden test cases (minimum 32 characters)
TEST_CASE_ENCRYPTION_KEY=your_test_case_encryption_key_here_minimum_32_characters_long

# Optional: Custom DNS servers for MongoDB Atlas SRV resolution (comma-separated IPv4/IPv6 addresses).
# Use when Node.js SRV resolution fails locally (e.g. ECONNREFUSED on Windows local resolver).
# Example: MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# LangSmith AI Observability (Node.js Express Server)
# Set LANGSMITH_TRACING=true to enable metadata-only Gemini observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_placeholder
LANGSMITH_PROJECT=prepai-server
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Internal Service-to-Service Secret (MANDATORY: authenticates Express requests to FastAPI AI service)
# Generate a high-entropy secret (e.g. openssl rand -hex 32). Must match ai-services exactly.
AI_SERVICE_SECRET=your_internal_service_secret_placeholder

# Reverse Proxy Trust Configuration:
# - Set to false (default) for local dev or direct internet facing server
# - Set to true when running behind reverse proxies (Vercel, Render, Cloudflare, AWS ALB)
# - Set to hop count (e.g. 1) or specific trusted subnets (e.g. "loopback, 10.0.0.0/8")
TRUST_PROXY=false

# Rate Limiting Configuration (Defaults shown; customize for production traffic tiers)
# RATE_LIMIT_GENERAL_MAX=100
# RATE_LIMIT_GENERAL_WINDOW_MS=900000
# RATE_LIMIT_AI_MAX=10
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_RESUME_MAX=3
# RATE_LIMIT_RESUME_WINDOW_MS=600000
# RATE_LIMIT_INTERVIEW_START_MAX=5
# RATE_LIMIT_INTERVIEW_START_WINDOW_MS=600000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=900000

